{
  "name": "athena-local",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-20",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "athena-preview",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "./drizzle"
    }
  ],
  "r2_buckets": [{ "binding": "DOCUMENTS", "bucket_name": "athena-documents" }]
}
